    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<b>\u0417\u0430\u043A\u0430\u0437 #1: \u041F\u0435\u0440\u0432\u044B\u0439 \u043E\u0431\u0440\u0430\u0437\u0435\u0446</b>\n<color=#94651C>\u0412 \u0420\u0410\u0411\u041E\u0422\u0415 \u2014 \u0441\u043A\u0440\u0435\u0449\u0438\u0432\u0430\u043D\u0438\u0439: 0 / 0</color>\n<size=12>\u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438 \xB7 \u043D\u0443\u0436\u0435\u043D \u0441\u043E\u0440\u0442: \u0411\u0435\u043B\u044B\u0439</size>\n\n<b>\u0417\u0430\u043A\u0430\u0437 #2: \u0422\u0451\u043F\u043B\u044B\u0439 \u043E\u043F\u044B\u0442</b>\n<color=#777064>\u041E\u0416\u0418\u0414\u0410\u0415\u0422</color>\n<size=12>\u0421\u0430\u0434\u043E\u0432\u043D\u0438\u043A-\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C \xB7 \u043D\u0443\u0436\u0435\u043D \u0441\u043E\u0440\u0442: \u041A\u0440\u0430\u0441\u043D\u044B\u0439</size>\n\n<b>\u0417\u0430\u043A\u0430\u0437 #3: \u0425\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u043E\u043F\u044B\u0442</b>\n<color=#777064>\u041E\u0416\u0418\u0414\u0410\u0415\u0422</color>\n<size=12>\u0410\u043F\u0442\u0435\u043A\u0430\u0440\u044C \xB7 \u043D\u0443\u0436\u0435\u043D \u0441\u043E\u0440\u0442: \u0421\u0438\u043D\u0438\u0439</size>\n\n<b>\u0417\u0430\u043A\u0430\u0437 #4: \u041F\u0430\u0441\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0433\u0438\u0431\u0440\u0438\u0434</b>\n<color=#777064>\u041E\u0416\u0418\u0414\u0410\u0415\u0422</color>\n<size=12>\u041F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440 \u0431\u043E\u0442\u0430\u043D\u0438\u043A\u0438 \xB7 \u043D\u0443\u0436\u0435\u043D \u0441\u043E\u0440\u0442: \u041B\u0430\u0432\u0430\u043D\u0434\u043E\u0432\u044B\u0439</size>\n\n<b>\u0417\u0430\u043A\u0430\u0437 #5: \u041F\u0435\u043F\u0435\u043B\u044C\u043D\u044B\u0439 \u0441\u043E\u0440\u043D\u044F\u043A</b>\n<color=#777064>\u041E\u0416\u0418\u0414\u0410\u0415\u0422</color>\n<size=12>\u0410\u0440\u0445\u0438\u0431\u043E\u0442\u0430\u043D\u0438\u043A \xB7 \u043D\u0443\u0436\u0435\u043D \u0441\u043E\u0440\u0442: \u041F\u0435\u043F\u0435\u043B\u044C\u043D\u044B\u0439 \u0441\u043E\u0440\u043D\u044F\u043A</size>\n\n"
